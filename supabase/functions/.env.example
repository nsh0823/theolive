# Secrets for the payment Edge Functions (local development values; copy to supabase/functions/.env, which is git-ignored).
# Serve with:  pnpm supabase functions serve --env-file supabase/functions/.env
PAYMENT_PROVIDER=TEST
# TEST gateway switch. Must NEVER be true where real money moves.
ALLOW_TEST_PG=true
PAYMENT_WEBHOOK_SECRET=local-test-webhook-secret-change-me
